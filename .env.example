# 复制为 .env 后填写；勿提交真实密钥。
# 生产环境：务必 astro build 后部署 dist/；勿将 astro dev / Vite dev 暴露公网。

# 推荐命名（与《docs/Astro站点对接方案-牛牛CMS-SEO-API.md》§2 一致）；与下方 NIUNIUCMS_* 二选一即可
# DATA_API_ORIGIN=https://sesewu3.eu.cc
# DATA_API_KEY=
# 多门户时与 vod_site_content.site_key 一致（可选）
# SITE_KEY=

# 用户看片站点根（无末尾 /、无 /admin）——与《docs/牛牛CMS-SEO-API与Webhook对接说明.md》§6.0 一致
NIUNIUCMS_ORIGIN=https://sesewu3.eu.cc
# 兼容旧名（与 NIUNIUCMS_ORIGIN 二选一即可）
# NIUNIUCMS_API_ORIGIN=https://sesewu3.eu.cc

# 与牛牛 config.php 中 seo_api_key / 后台「SEO 开放接口」一致
NIUNIUCMS_API_KEY=

# 可选：多门户 — 与库表 vod_site_content.site_key 一致；构建时所有请求带 ?site= 与头 X-Site-Key（见 docs/Astro站点对接方案-牛牛CMS-SEO-API.md §2）
# SITE_KEY=

# hyphen = api-latest.html 风格（url_rewrite_on 0/1）；path = /api/latest（2/3）
NIUNIUCMS_URL_STYLE=hyphen

# meta = 分页 api-meta-slugs 生成全站 /movie/[slug]；preview = 仅用 latest+hot 中的 slug
NIUNIUCMS_BUILD_SLUGS=meta

# 可选：发现池未出现的标签，逗号分隔（对应 /tag/tag-{id}.html）
# NIUNIUCMS_EXTRA_TAG_SLUGS=tag-12,tag-34

# 可选：「搜影片」弹层额外拉详情并入搜索数据的 slug（逗号分隔），用于长尾剧不在 hot/latest/today 池时仍能搜到
# NIUNIUCMS_SEARCH_GUIDE_EXTRA_SLUGS=wan-mei-shi-jie,another-slug

# 可选：额外预渲染 /topics/[slug]（逗号分隔），与 api-topic-slugs 分页结果合并；正文来自 GET /api-topic.html?slug=
# NIUNIUCMS_SEO_TOPIC_SLUGS=my-topic-slug,kuala-lumpur-peripheral-movies

# 可选：首页「热门演员」等——列表无 actors/vod_actor/演员时，按条数补拉详情（默认 24，最大 60；0=关闭）
# NIUNIUCMS_HOME_DETAIL_ENRICH=24

# 【必填·上线】Astro 站点最终域名（canonical / sitemap / robots.txt 里的 Sitemap），须与浏览器访问域名一致；无尾斜杠。可与 CMS 域名不同。
# 不设则 sitemap 内会出现占位域 movie-seo.example.com，Search Console 无法抓取子地图。
# SITE=https://so1.m8ktv.top

# 可选：纯静态托管（无 Node）时，浏览器请求此外域 BFF（GET portal-cta?slug=、GET search-guide）；示例默认留空则使用 Astro hybrid 自带的 /api/runtime/*
# PUBLIC_RUNTIME_API_BASE=https://your-worker.example.workers.dev/api/runtime

# 可选：覆盖观影指南等栏目底部「直达」网址（默认 https://dydh.m8ktv.top/，与 public/guide-qr.png 一致）
# PUBLIC_GUIDE_PORTAL_URL=https://dydh.m8ktv.top/
# PUBLIC_GUIDE_PORTAL_LABEL=dydh.m8ktv.top

# --- 可选：社交分享 / 页脚 ---
# 对外展示名（页眉、分享卡 site_name）；默认「影视精选」
# PUBLIC_SITE_NAME=影视精选
# 全站一句话描述（WebSite 结构化数据）；不设则用内置默认文案
# PUBLIC_SITE_DESCRIPTION=
# twitter:site（可写 @xxx 或 xxx）
# PUBLIC_TWITTER_HANDLE=
# 页脚「社交媒体」仅当值为完整 https URL 时显示一条链接
# PUBLIC_SOCIAL_WEIBO=https://weibo.com/u/...
# PUBLIC_SOCIAL_WECHAT_ARTICLE=https://...
# PUBLIC_SOCIAL_TELEGRAM=https://t.me/...
# PUBLIC_SOCIAL_WHATSAPP=https://wa.me/...
# PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/...
# PUBLIC_SOCIAL_X=https://x.com/...
# PUBLIC_SOCIAL_QQ=https://...
# PUBLIC_SOCIAL_BILIBILI=https://space.bilibili.com/...
