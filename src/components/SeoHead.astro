---
import { SITE_DISPLAY_NAME } from '../lib/site-brand';

/**
 * Open Graph、Twitter Card、hreflang 等元数据（面向 SEO / 链接预览，无可见 UI）。
 * 默认分享图：`public/og-default.png`（1200×630 PNG）。
 */
interface Props {
	title: string;
	description: string;
	path: string;
	ogImage?: string;
	/** og:image / twitter:image 的 alt，建议影片页传「某某 海报」 */
	ogImageAlt?: string;
	/** 默认 website；影片页可传 video.movie */
	ogType?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	path,
	ogImage,
	ogImageAlt,
	ogType = 'website',
	jsonLd,
} = Astro.props;

const pageOrigin = Astro.site?.origin ?? Astro.url.origin;
const pathNormalized = path.startsWith('/') ? path : `/${path}`;
const canonical = new URL(pathNormalized, `${pageOrigin}/`).href;

const fallbackOgPath = '/og-default.png';

function toAbsoluteOgImage(src: string | undefined): string {
	const raw = (src ?? '').trim();
	if (!raw) return new URL(fallbackOgPath.slice(1), `${pageOrigin}/`).href;
	if (/^https?:\/\//i.test(raw)) return raw;
	if (raw.startsWith('//')) return `https:${raw}`;
	const pathPart = raw.startsWith('/') ? raw : `/${raw}`;
	return new URL(pathPart.slice(1), `${pageOrigin}/`).href;
}

const imageUrl = toAbsoluteOgImage(ogImage);
const imageAlt = (ogImageAlt ?? title).trim() || title;
const siteName =
	(import.meta.env.PUBLIC_SITE_NAME as string | undefined)?.trim() || SITE_DISPLAY_NAME;
const twitterHandle = (import.meta.env.PUBLIC_TWITTER_HANDLE as string | undefined)?.trim();
const twitterSite =
	twitterHandle != null && twitterHandle !== ''
		? twitterHandle.startsWith('@')
			? twitterHandle
			: `@${twitterHandle}`
		: null;

const usingDefaultOg = imageUrl.endsWith('/og-default.png') || imageUrl.endsWith('og-default.png');

const ld =
	jsonLd == null ? null : Array.isArray(jsonLd) ? jsonLd : [jsonLd];

const imageSecure = /^https:\/\//i.test(imageUrl) ? imageUrl : null;
---

<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="zh-CN" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{imageSecure && <meta property="og:image:secure_url" content={imageSecure} />}
<meta property="og:image:alt" content={imageAlt} />
{usingDefaultOg && (
	<>
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
	</>
)}

<meta name="twitter:card" content="summary_large_image" />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{
	ld && (
		<script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
	)
}
