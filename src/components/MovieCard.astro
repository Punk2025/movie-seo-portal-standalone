---
import type { Movie } from '../types/content';
import { paths } from '../lib/paths';

interface Props {
	movie: Movie;
}

const { movie } = Astro.props;
---

<a
	href={paths.movie(movie.slug)}
	class="group flex gap-3 rounded-lg border border-zinc-200 bg-white p-3 shadow-sm transition hover:border-amber-400 dark:border-zinc-700 dark:bg-zinc-900"
>
	<img
		src={movie.cover}
		alt=""
		width="72"
		height="108"
		class="h-[108px] w-[72px] shrink-0 rounded object-cover"
		loading="lazy"
		decoding="async"
	/>
	<div class="min-w-0 flex-1">
		<h3 class="truncate font-semibold text-zinc-900 group-hover:text-amber-700 dark:text-zinc-100 dark:group-hover:text-amber-400">
			{movie.title}
		</h3>
		<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
			{movie.year}
			{movie.score != null ? ` · ${movie.score} 分` : ''}
			{movie.update_status ? ` · ${movie.update_status}` : ''}
		</p>
	</div>
</a>
