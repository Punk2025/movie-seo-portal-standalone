---
/**
 * 首页顶部：主题榜单入口（数据 `THEME_HUB_ENTRIES`，见 themeHub.ts）
 */
import { THEME_HUB_ENTRIES } from '../data/themeHub';
import { paths } from '../lib/paths';
---

<section
	class="mb-8 rounded-xl border border-zinc-200 bg-white px-4 py-6 shadow-sm dark:border-zinc-700 dark:bg-zinc-900/60"
	aria-labelledby="home-category-strip-title"
>
	<h2 id="home-category-strip-title" class="text-xl font-bold text-zinc-900 dark:text-zinc-50">
		热门分类与主题榜单
	</h2>
	<p class="mt-3 max-w-3xl leading-relaxed text-zinc-700 dark:text-zinc-300">
		奈飞热播、悬疑佳作、年度剧情等主题入口，便于按兴趣延伸浏览。
		<a
			href={paths.topicsIndex()}
			class="ml-1 font-medium text-amber-700 underline-offset-2 hover:underline dark:text-amber-400"
		>
			查看全部专题 →
		</a>
	</p>
	<nav class="mt-4" aria-label="主题榜单入口">
		<ul class="flex flex-wrap gap-2">
			{
				THEME_HUB_ENTRIES.map((card) => (
					<li>
						<a
							href={card.href}
							title={card.subtitle ?? card.label}
							class="inline-flex max-w-[min(100%,18rem)] flex-col rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-left text-sm font-medium text-zinc-800 hover:border-amber-400 hover:text-amber-800 dark:border-zinc-600 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:border-amber-500 dark:hover:text-amber-300"
						>
							<span>{card.label}</span>
							{card.subtitle ? (
								<span class="mt-0.5 text-[11px] font-normal leading-snug text-zinc-500 dark:text-zinc-400">
									{card.subtitle}
								</span>
							) : null}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</section>
