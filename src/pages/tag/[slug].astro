---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieCard from '../../components/MovieCard.astro';
import { getAllTags, getMoviesByTag } from '../../data/mock';
import {
	getNiuniuClientFromEnv,
	getNiuniuDiscoveryPool,
	extraTagSlugsFromEnv,
	isNiuniuConfigured,
	moviesForTagSlug,
	uniqueTagsFromMovies,
} from '../../data/niuniu-build';
import { paths } from '../../lib/paths';
import { HOME_COLUMN_TOP_BLOCK } from '../../lib/column-seo-copy';
import { buildTagPageIntro } from '../../lib/tag-page-intro';

export async function getStaticPaths() {
	if (isNiuniuConfigured()) {
		try {
			const cfg = getNiuniuClientFromEnv();
			const pool = await getNiuniuDiscoveryPool(cfg);
			const tags = uniqueTagsFromMovies(pool);
			const slugSet = new Set(tags.map((t) => t.slug));
			for (const s of extraTagSlugsFromEnv()) {
				slugSet.add(s);
			}
			return [...slugSet].map((s) => ({ params: { slug: s } }));
		} catch {
			return [];
		}
	}

	return getAllTags().map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect('/404');
}

let tag: { name: string; slug: string } | undefined;
let list: import('../../types/content').Movie[] = [];

if (isNiuniuConfigured()) {
	try {
		const cfg = getNiuniuClientFromEnv();
		const pool = await getNiuniuDiscoveryPool(cfg);
		const tags = uniqueTagsFromMovies(pool);
		tag = tags.find((t) => t.slug === slug);
		if (!tag && /^tag-\d+$/.test(slug)) {
			tag = { name: slug, slug };
		}
		list = tag ? await moviesForTagSlug(cfg, slug, pool) : [];
	} catch {
		tag = undefined;
	}
} else {
	const tags = getAllTags();
	tag = tags.find((t) => t.slug === slug);
	list = tag ? getMoviesByTag(tag.slug) : [];
}

if (!tag) {
	return Astro.redirect('/404');
}

const title = `${tag.name} · 标签聚合`;
const introBody = buildTagPageIntro(tag.name, tag.slug);
const description =
	introBody.length > 158 ? `${introBody.slice(0, 155).trim()}…` : introBody;
const path = paths.tag(tag.slug);

const TAG_GRID_PREVIEW = 6;

const itemListJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: title,
	numberOfItems: list.length,
	itemListElement: list.map((m, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: new URL(paths.movie(m.slug), Astro.site).href,
		name: m.title,
	})),
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={itemListJsonLd}>
	<div class="py-10">
		<section class="mb-8 rounded-xl border border-zinc-200 bg-white px-4 py-5 shadow-sm dark:border-zinc-700 dark:bg-zinc-900/60">
			<h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
				{HOME_COLUMN_TOP_BLOCK.h2}
			</h2>
			<p class="mt-3 max-w-3xl leading-relaxed text-zinc-700 dark:text-zinc-300">{HOME_COLUMN_TOP_BLOCK.p}</p>
		</section>
		<h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50">「{tag.name}」类型片单</h1>
		<p class="mt-5 max-w-3xl leading-relaxed text-zinc-700 dark:text-zinc-300">{introBody}</p>
	</div>

	<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		{list.slice(0, TAG_GRID_PREVIEW).map((m) => (
			<MovieCard movie={m} />
		))}
		{
			list.length > TAG_GRID_PREVIEW && (
				<details class="col-span-full rounded-xl border border-zinc-200 bg-zinc-50/60 px-4 py-3 dark:border-zinc-700 dark:bg-zinc-900/40">
					<summary class="cursor-pointer text-sm font-semibold text-amber-800 dark:text-amber-400">
						展开其余 {list.length - TAG_GRID_PREVIEW} 条
					</summary>
					<div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
						{list.slice(TAG_GRID_PREVIEW).map((m) => (
							<MovieCard movie={m} />
						))}
					</div>
				</details>
			)
		}
	</div>

	<section class="mt-14 space-y-4">
		<h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">热门入口</h2>
		<ul class="flex flex-wrap gap-3 text-sm">
			<li>
				<a href={paths.top('netflix')} class="text-amber-700 hover:underline dark:text-amber-400">
					Netflix 榜单
				</a>
			</li>
			<li>
				<a href={paths.top('suspense')} class="text-amber-700 hover:underline dark:text-amber-400">
					悬疑精选
				</a>
			</li>
			<li>
				<a href={paths.home()} class="text-amber-700 hover:underline dark:text-amber-400">
					返回首页
				</a>
			</li>
		</ul>
	</section>
</BaseLayout>
