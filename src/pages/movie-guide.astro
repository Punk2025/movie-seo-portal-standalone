---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuidePortalCallout from '../components/GuidePortalCallout.astro';
import { paths } from '../lib/paths';
import { SITE_DISPLAY_NAME } from '../lib/site-brand';

const title = `观影指南 · 正版观看与阅读说明 | ${SITE_DISPLAY_NAME}`;
const description =
	'设备与网络建议、正版观看渠道说明，以及如何在本站浏览影片资讯；进阶观影推荐可通过独立入口获取，与剧情正文区分。';
const path = paths.movieGuide();

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: '观影指南：正版渠道与阅读说明',
	description,
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
	<article class="mx-auto max-w-3xl space-y-8 py-10">
		<header class="space-y-3">
			<h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">观影指南</h1>
			<p class="text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
				这里专门说明<strong>如何合法、安全地观看影视作品</strong>，以及本站资讯页的定位。剧情解读、演员与标签详情仍在各影片
				<strong>详情页</strong>呈现；商业合作类「观影路径」入口集中在本页底部区块，避免干扰正文阅读。
			</p>
		</header>

		<section class="space-y-4 text-zinc-700 dark:text-zinc-300" aria-labelledby="mg-s1">
			<h2 id="mg-s1" class="text-xl font-bold text-zinc-900 dark:text-zinc-50">
				正版渠道与版权提示
			</h2>
			<p class="leading-relaxed">
				影视作品受著作权保护。观看正片请选择版权方或授权平台提供的点播、租赁或院线渠道；本站为<strong>信息与阅读聚合</strong>，不提供正片存储、下载或播放接口。
			</p>
			<p class="leading-relaxed">
				若您发现页面信息有误或存在侵权线索，欢迎通过
				<a href={paths.contact()} class="text-amber-700 hover:underline dark:text-amber-400">联系我们</a>
				反馈，我们会在核实后更新或下线相关内容。
			</p>
		</section>

		<section class="space-y-4 text-zinc-700 dark:text-zinc-300" aria-labelledby="mg-s2">
			<h2 id="mg-s2" class="text-xl font-bold text-zinc-900 dark:text-zinc-50">
				设备与网络体验
			</h2>
			<p class="leading-relaxed">
				在手机或平板上阅读长文时，建议开启系统字体大小与对比度设置以获得更舒适阅读体验；使用家庭网络或可信 Wi‑Fi
				可降低公共网络下的隐私风险。大屏浏览影片资料时，可适当放大浏览器字号，避免眯眼阅读剧情摘要。
			</p>
		</section>

		<section class="space-y-4 text-zinc-700 dark:text-zinc-300" aria-labelledby="mg-s3">
			<h2 id="mg-s3" class="text-xl font-bold text-zinc-900 dark:text-zinc-50">
				如何在本站发现内容
			</h2>
			<p class="leading-relaxed">
				首页提供今日更新、热门与主题榜单入口；您也可以通过顶部「搜影片」在浮层中按片名查找。每部影片有独立 URL，便于收藏与分享；站内外链遵循
				<a href={paths.disclaimer()} class="text-amber-700 hover:underline dark:text-amber-400">免责声明</a>
				中的说明。
			</p>
		</section>

		<GuidePortalCallout
			eyebrow="进阶入口"
			title="扫码或访问合作导航"
			intro="若您还需要更完整的片单整理、观看路径说明或合作方提供的导航服务，可使用下方入口。本站不对第三方页面内容与可用性承担保证责任。"
		/>
	</article>
</BaseLayout>
