---
import BaseLayout from '../layouts/BaseLayout.astro';
import { paths } from '../lib/paths';
import { SITE_DISPLAY_NAME } from '../lib/site-brand';

const title = `作者信息 | ${SITE_DISPLAY_NAME}`;
const description = '本站运营主体、编辑与内容来源（请上线前替换为真实主体信息）。';
const path = paths.author();
---

<BaseLayout title={title} description={description} path={path}>
	<article class="mx-auto max-w-3xl space-y-6 py-10 text-zinc-700 dark:text-zinc-300">
		<h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50">作者信息</h1>
		<p class="leading-relaxed">
			为便于用户信任，本站公开<strong>内容责任与编辑主体</strong>的基本说明。下列信息为<strong>示例占位</strong>，正式上线前请替换为营业执照名称、ICP
			备案号、主编署名等真实资料。
		</p>
		<dl class="space-y-4 rounded-lg border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-900">
			<div>
				<dt class="text-sm font-medium text-zinc-500 dark:text-zinc-400">运营主体（示例）</dt>
				<dd class="mt-1 text-zinc-900 dark:text-zinc-50">某某科技有限公司 / 个人工作室名称</dd>
			</div>
			<div>
				<dt class="text-sm font-medium text-zinc-500 dark:text-zinc-400">责任编辑 / 主编（示例）</dt>
				<dd class="mt-1 text-zinc-900 dark:text-zinc-50">编辑部（可署笔名或团队名）</dd>
			</div>
			<div>
				<dt class="text-sm font-medium text-zinc-500 dark:text-zinc-400">内容来源</dt>
				<dd class="mt-1 space-y-3 leading-relaxed">
					<p>
						本站展示的影视<strong>基础信息</strong>（如片名、剧情简介、演职员、类型标签、连载/更新状态、海报等）在<strong>依法可使用、已获授权或可公开引用</strong>的范围内，由运营方自合作数据与公开网络资料<strong>收集、整理与呈现</strong>。资料会持续更新，本站尽力保证准确，但无法对全部第三方数据的实时性与完整性承担无限担保。
					</p>
					<p>
						「<strong>影评摘录</strong>」等由系统自动生成的栏目，在数据就绪时发布，属阅读辅助材料，<strong>非</strong>人工独立采写的新闻稿或署名专业影评。选题、核对与纠错机制见
						<a href={paths.editorial()} class="text-amber-700 hover:underline dark:text-amber-400">
							编辑政策
						</a>
						；著作权与免责等事项见
						<a href={paths.disclaimer()} class="text-amber-700 hover:underline dark:text-amber-400">
							免责声明
						</a>。
					</p>
				</dd>
			</div>
		</dl>
		<p class="leading-relaxed text-sm text-zinc-500 dark:text-zinc-400">
			若需核实主体资质或更正署名，请通过
			<a href={paths.contact()} class="text-amber-700 hover:underline dark:text-amber-400">
				联系我们
			</a>。
		</p>
	</article>
</BaseLayout>
