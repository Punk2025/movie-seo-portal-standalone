---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	collectMovieSlugsForBuild,
	getNiuniuClientFromEnv,
	isNiuniuConfigured,
	loadMovieFromNiuniu,
} from '../../data/niuniu-build';
import { getMovieBySlug, getUpdateBySlug, updates } from '../../data/mock';
import { paths } from '../../lib/paths';

export async function getStaticPaths() {
	if (isNiuniuConfigured()) {
		try {
			const cfg = getNiuniuClientFromEnv();
			const slugs = await collectMovieSlugsForBuild(cfg);
			return slugs.map((slug) => ({ params: { slug } }));
		} catch {
			return [];
		}
	}

	return updates.map((u) => ({ params: { slug: u.slug } }));
}

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect('/404');
}

let title: string;
let description: string;
let updatedAt: string;
let aiSummary: string;
let watchReason: string;
let movie: import('../../types/content').Movie | undefined;

if (isNiuniuConfigured()) {
	const cfg = getNiuniuClientFromEnv();
	const m = await loadMovieFromNiuniu(cfg, slug);
	if (!m) {
		return Astro.redirect('/404');
	}
	movie = m;
	title = `${movie.title} · 更新与追剧说明`;
	description = `${movie.title} 最新更新：${movie.update_status}`.slice(0, 160);
	updatedAt = movie.publish_time;
	aiSummary =
		movie.update_status +
		(movie.description.length > 40 ? `\n\n${movie.description.slice(0, 400)}` : '');
	watchReason =
		movie.ai_review?.slice(0, 280) ??
		`喜欢「${movie.title}」同类题材的观众，可从剧情张力与口碑热度考虑跟进观看。`;
} else {
	const update = getUpdateBySlug(slug);
	if (!update) {
		return Astro.redirect('/404');
	}
	movie = getMovieBySlug(update.movie_slug);
	title = `${movie?.title ?? '剧集'} 第 ${update.season} 季第 ${update.episode} 集更新说明`;
	description = update.ai_summary.slice(0, 160);
	updatedAt = update.updated_at;
	aiSummary = update.ai_summary;
	watchReason = update.watch_reason;
}

const path = paths.update(slug);

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: '首页',
			item: new URL('/', Astro.site).href,
		},
		...(movie
			? [
					{
						'@type': 'ListItem',
						position: 2,
						name: movie.title,
						item: new URL(paths.movie(movie.slug), Astro.site).href,
					},
				]
			: []),
		{
			'@type': 'ListItem',
			position: movie ? 3 : 2,
			name: title,
			item: new URL(path, Astro.site).href,
		},
	],
};

const newsArticleJsonLd =
	movie &&
	({
		'@context': 'https://schema.org',
		'@type': 'NewsArticle',
		headline: title,
		datePublished: updatedAt,
		description: description,
		image: movie.cover,
	} as Record<string, unknown>);
---

<BaseLayout
	title={title}
	description={description}
	path={path}
	ogImage={movie?.cover}
	jsonLd={newsArticleJsonLd ? [newsArticleJsonLd, breadcrumbJsonLd] : breadcrumbJsonLd}
>
	<article class="py-10">
		<h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50">{title}</h1>
		<p class="mt-3 text-sm text-zinc-500">
			更新时间：<time datetime={updatedAt}>{updatedAt}</time>
		</p>

		{
			movie && (
				<p class="mt-6">
					<a href={paths.movie(movie.slug)} class="font-medium text-amber-700 hover:underline dark:text-amber-400">
						← 返回《{movie.title}》详情
					</a>
				</p>
			)
		}

		<section class="mt-10 space-y-4">
			<h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">更新说明</h2>
			<p class="whitespace-pre-line leading-relaxed text-zinc-700 dark:text-zinc-300">{aiSummary}</p>
		</section>

		<section class="mt-10 space-y-4">
			<h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">推荐观看理由</h2>
			<p class="leading-relaxed text-zinc-700 dark:text-zinc-300">{watchReason}</p>
		</section>
	</article>
</BaseLayout>
