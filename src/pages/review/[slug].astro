---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieCard from '../../components/MovieCard.astro';
import {
	collectMovieSlugsForBuild,
	getNiuniuClientFromEnv,
	isNiuniuConfigured,
	loadMovieFromNiuniu,
	loadRelatedMovies,
	splitAiReviewToSections,
} from '../../data/niuniu-build';
import { getMovieBySlug, getMoviesBySlug, reviews } from '../../data/mock';
import { paths } from '../../lib/paths';
import { SITE_DISPLAY_NAME } from '../../lib/site-brand';

export async function getStaticPaths() {
	if (isNiuniuConfigured()) {
		try {
			const cfg = getNiuniuClientFromEnv();
			const slugs = await collectMovieSlugsForBuild(cfg);
			return slugs.map((slug) => ({ params: { slug } }));
		} catch {
			return [];
		}
	}

	return reviews.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect('/404');
}

let title: string;
let description: string;
let sections: { heading: string; body: string }[];
let movie: import('../../types/content').Movie | undefined;
let related: import('../../types/content').Movie[] = [];

if (isNiuniuConfigured()) {
	const cfg = getNiuniuClientFromEnv();
	const m = await loadMovieFromNiuniu(cfg, slug);
	if (!m) {
		return Astro.redirect('/404');
	}
	movie = m;
	title =
		m.seoTitle ?? `${m.title} 值得看吗？剧情解析与观影建议`;
	const descFromBody = (m.ai_review ?? m.description).trim().slice(0, 160);
	description = m.seoDescription ?? (descFromBody || `${m.title} 影评与解读`);
	sections = splitAiReviewToSections(m.ai_review ?? m.description);
	related = await loadRelatedMovies(cfg, m.related_movies, 6);
} else {
	const record = reviews.find((r) => r.slug === slug);
	if (!record) {
		return Astro.redirect('/404');
	}
	movie = getMovieBySlug(record.movie_slug);
	related = movie ? getMoviesBySlug(movie.related_movies) : [];
	title = record.meta_title;
	description = record.meta_description;
	sections = record.sections;
}

const path = paths.review(slug);

const reviewJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Review',
	itemReviewed: movie
		? {
				'@type': 'Movie',
				name: movie.title,
				image: movie.cover,
			}
		: undefined,
	reviewBody: sections.map((s) => `${s.heading}: ${s.body}`).join('\n'),
	author: { '@type': 'Organization', name: SITE_DISPLAY_NAME },
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: '首页',
			item: new URL('/', Astro.site).href,
		},
		...(movie
			? [
					{
						'@type': 'ListItem',
						position: 2,
						name: movie.title,
						item: new URL(paths.movie(movie.slug), Astro.site).href,
					},
				]
			: []),
		{
			'@type': 'ListItem',
			position: movie ? 3 : 2,
			name: title,
			item: new URL(path, Astro.site).href,
		},
	],
};
---

<BaseLayout
	title={title}
	description={description}
	path={path}
	ogImage={movie?.cover}
	ogImageAlt={movie ? `${movie.title} 海报` : title}
	ogType="article"
	jsonLd={[reviewJsonLd, breadcrumbJsonLd]}
>
	<article class="py-10">
		<h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50">{title}</h1>
		<p class="mt-3 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>

		{
			movie && (
				<p class="mt-6 text-sm">
					<span class="text-zinc-500">关联影片：</span>
					<a href={paths.movie(movie.slug)} class="font-medium text-amber-700 hover:underline dark:text-amber-400">
						{movie.title}
					</a>
				</p>
			)
		}

		<div class="mt-10 space-y-10">
			{
				sections.map((s) => (
					<section>
						<h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">{s.heading}</h2>
						<p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">{s.body}</p>
					</section>
				))
			}
		</div>

		<section class="mt-14 space-y-4">
			<h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">类似推荐</h2>
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{related.map((m) => (
					<MovieCard movie={m} />
				))}
			</div>
		</section>
	</article>
</BaseLayout>
