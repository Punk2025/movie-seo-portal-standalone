---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteSearchGuide from '../components/SiteSearchGuide.astro';
import { SITE_DEFAULT_DESCRIPTION, SITE_DISPLAY_NAME } from '../lib/site-brand';
import { buildSiteGraphJsonLd } from '../lib/jsonld-site-graph';
import { getSearchGuidePayload } from '../lib/search-guide-payload';
import { isNiuniuConfigured } from '../data/niuniu-build';
import { getPublicSocialLinks } from '../lib/site-social';
import { paths } from '../lib/paths';
import { THEME_HUB_ENTRIES } from '../data/themeHub';

interface Props {
	title: string;
	description: string;
	path: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path, ogImage, ogImageAlt, ogType, jsonLd } = Astro.props;
const socialLinks = getPublicSocialLinks();

const siteOrigin =
	Astro.site != null
		? typeof Astro.site === 'string'
			? new URL(Astro.site).origin
			: Astro.site.origin
		: Astro.url.origin;
const siteName =
	(import.meta.env.PUBLIC_SITE_NAME as string | undefined)?.trim() || SITE_DISPLAY_NAME;
const siteDescription =
	(import.meta.env.PUBLIC_SITE_DESCRIPTION as string | undefined)?.trim() || SITE_DEFAULT_DESCRIPTION;
const siteGraphLd = buildSiteGraphJsonLd({
	origin: siteOrigin,
	siteName,
	description: siteDescription,
	sameAs: socialLinks.map((s) => s.href),
});
const searchGuideItems = await getSearchGuidePayload();
const runtimePortalSync = isNiuniuConfigured();
const runtimeApiBase = (import.meta.env.PUBLIC_RUNTIME_API_BASE ?? '').toString().trim();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<SeoHead
			title={title}
			description={description}
			path={path}
			ogImage={ogImage}
			ogImageAlt={ogImageAlt}
			ogType={ogType}
			jsonLd={jsonLd}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(siteGraphLd)} />
	</head>
	<body
		class="flex min-h-screen flex-col bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100"
	>
		<header class="border-b border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-4">
				<a href={paths.home()} class="text-lg font-bold text-amber-700 dark:text-amber-400">
					{SITE_DISPLAY_NAME}
				</a>
				<div class="flex flex-wrap items-center justify-end gap-3 sm:gap-4">
					<SiteSearchGuide
						items={searchGuideItems}
						runtimePortalSync={runtimePortalSync}
						runtimeApiBase={runtimeApiBase}
					/>
					<nav class="flex flex-wrap gap-4 text-sm font-medium text-zinc-600 dark:text-zinc-300">
						<a href={paths.home()} class="hover:text-amber-700 dark:hover:text-amber-400">首页</a>
						<a href={paths.topicsIndex()} class="hover:text-amber-700 dark:hover:text-amber-400">
							专题
						</a>
						<a href={paths.reviewsHub()} class="hover:text-amber-700 dark:hover:text-amber-400">
							观看影评
						</a>
						<a href={paths.movieGuide()} class="hover:text-amber-700 dark:hover:text-amber-400">
							观影指南
						</a>
						<a href={paths.movieNav()} class="hover:text-amber-700 dark:hover:text-amber-400">
							影视导航
						</a>
						<a href={paths.movieCommunity()} class="hover:text-amber-700 dark:hover:text-amber-400">
							影视社区
						</a>
						<a href={paths.resourceRecommend()} class="hover:text-amber-700 dark:hover:text-amber-400">
							资源推荐
						</a>
						{
							THEME_HUB_ENTRIES.filter((e) => e.href.startsWith('/top/')).map((e) => (
								<a href={e.href} class="hover:text-amber-700 dark:hover:text-amber-400">
									{e.label}
								</a>
							))
						}
					</nav>
				</div>
			</div>
		</header>
		<main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-16">
			<slot />
		</main>
		<footer class="border-t border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
			<div class="mx-auto max-w-6xl px-4 py-10">
				<nav
					class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-3 lg:grid-cols-4"
					aria-label="站点信息"
				>
					<a
						href={paths.about()}
						class="text-zinc-600 hover:text-amber-700 dark:text-zinc-400 dark:hover:text-amber-400"
					>
						关于我们
					</a>
					<a
						href={paths.contact()}
						class="text-zinc-600 hover:text-amber-700 dark:text-zinc-400 dark:hover:text-amber-400"
					>
						联系我们
					</a>
					<a
						href={paths.author()}
						class="text-zinc-600 hover:text-amber-700 dark:text-zinc-400 dark:hover:text-amber-400"
					>
						作者信息
					</a>
					<a
						href={paths.publication()}
						class="text-zinc-600 hover:text-amber-700 dark:text-zinc-400 dark:hover:text-amber-400"
					>
						发布与更新
					</a>
					<a
						href={paths.editorial()}
						class="text-zinc-600 hover:text-amber-700 dark:text-zinc-400 dark:hover:text-amber-400"
					>
						编辑政策
					</a>
					<a
						href={paths.privacy()}
						class="text-zinc-600 hover:text-amber-700 dark:text-zinc-400 dark:hover:text-amber-400"
					>
						隐私政策
					</a>
					<a
						href={paths.terms()}
						class="text-zinc-600 hover:text-amber-700 dark:text-zinc-400 dark:hover:text-amber-400"
					>
						服务条款
					</a>
					<a
						href={paths.disclaimer()}
						class="text-zinc-600 hover:text-amber-700 dark:text-zinc-400 dark:hover:text-amber-400"
					>
						免责声明
					</a>
				</nav>
				{
					socialLinks.length > 0 && (
						<div class="mt-8 border-t border-zinc-200 pt-8 dark:border-zinc-700">
							<p class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
								社交媒体
							</p>
							<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
								{socialLinks.map((s) => (
									<li>
										<a
											href={s.href}
											class="text-zinc-600 underline-offset-2 hover:text-amber-700 hover:underline dark:text-zinc-400 dark:hover:text-amber-400"
											target="_blank"
											rel="me noopener noreferrer"
										>
											{s.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
				<p class="mt-8 text-center text-xs text-zinc-500 dark:text-zinc-500">
					影视资讯聚合与阅读，不提供正片点播或下载。
				</p>
			</div>
		</footer>
	</body>
</html>
